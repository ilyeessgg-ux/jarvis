# Copy to .env and fill in your own key.
#
# Default provider: OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-key-here
# Free default that supports tool calling. With credits, try openai/gpt-4o-mini.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# AgentRouter alternative (https://agentrouter.org):
# Replace the two values above with these three lines.
# OPENROUTER_API_KEY=<your AgentRouter API key>
# OPENROUTER_BASE_URL=https://agentrouter.org/v1
# OPENROUTER_MODEL=deepseek-v4-flash

JARVIS_USER_NAME=sir
JARVIS_CITY=London
JARVIS_VOICE=en-GB-RyanNeural
JARVIS_WAKE_ENABLED=true
JARVIS_SPEAK_REPLIES=true
JARVIS_WAKE_THRESHOLD=0.55

JARVIS_HOST=127.0.0.1
JARVIS_PORT=7777
